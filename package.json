{
  "name": "interlinear.io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @interlinear/server --filter @interlinear/web dev",
    "dev:server": "pnpm --filter @interlinear/server dev",
    "dev:web": "pnpm --filter @interlinear/web dev",
    "build": "pnpm --filter @interlinear/web build",
    "start": "pnpm --filter @interlinear/server start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @interlinear/server test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
